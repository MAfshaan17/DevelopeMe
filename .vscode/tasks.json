{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prepwise: Start development server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Prepwise: Run checks",
			"type": "shell",
			"command": "node",
			"args": [
				"--check",
				"public/app.js"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}